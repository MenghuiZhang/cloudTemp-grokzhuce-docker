# Compose 项目名决定容器和独立网络的前缀。
# 正式环境使用 grok-prod；测试环境复制本文件后改为 grok-test。
COMPOSE_PROJECT_NAME=grok-prod

# 端口仅绑定宿主机回环地址，由现有 1Panel 网站对外提供 HTTPS。
GROK_BIND_ADDRESS=127.0.0.1
GROK_HOST_PORT=3333

# GHCR 仓库名必须小写。正式环境固定 vX.Y.Z，测试环境可使用 main。
GROK_IMAGE_REPOSITORY=ghcr.io/menghuizhang/cloudtemp-grokzhuce-docker
GROK_IMAGE_REF=ghcr.io/menghuizhang/cloudtemp-grokzhuce-docker:v1.4.0

# Dockerfile 的健康检查包含 90 秒启动宽限期。
DEPLOY_HEALTH_TIMEOUT=180
