# 该文件含备份仓库凭据。复制为 restic.env 后执行 chmod 600。
# RESTIC_REPOSITORY 可替换为 S3、SFTP 或另一台服务器上的 restic 仓库。
RESTIC_REPOSITORY=s3:https://OBJECT_STORAGE_ENDPOINT/BUCKET/grok-prod
RESTIC_PASSWORD_FILE=/etc/grok-backup/restic-password

# S3 兼容对象存储示例；不用 S3 时删除以下两行。
AWS_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_KEY
