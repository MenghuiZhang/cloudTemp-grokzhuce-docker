# ---------- 统一邮箱服务 ----------
# outlook | freemail | yyds | cloudflare_temp
EMAIL_PROVIDER=
EMAIL_TIMEOUT_SECONDS=120
# direct | register | custom | system
EMAIL_PROXY_MODE=direct
EMAIL_PROXY_URL=
EMAIL_TLS_VERIFY=1

# Outlook / Hotmail Plus Alias
# JSON 数组字段: email,password,refresh_token,client_id,alias_limit
EMAIL_OUTLOOK_ACCOUNTS_JSON=[]
EMAIL_OUTLOOK_DEFAULT_ALIAS_LIMIT=5
EMAIL_OUTLOOK_CONCURRENCY=5

# Cloudflare Freemail (idinging/freemail)
EMAIL_FREEMAIL_BASE_URL=
EMAIL_FREEMAIL_TOKEN=
EMAIL_FREEMAIL_DOMAIN=auto
EMAIL_FREEMAIL_CONCURRENCY=10

# YYDS Mail
EMAIL_YYDS_BASE_URL=https://maliapi.215.im/v1
EMAIL_YYDS_API_KEY=
EMAIL_YYDS_DOMAIN=auto
EMAIL_YYDS_PLATFORM_CODE=grok
EMAIL_YYDS_CONCURRENCY=5

# Cloudflare Temp Email (dreamhunter2333/cloudflare_temp_email)
EMAIL_CF_TEMP_BASE_URL=https://your-worker.workers.dev
EMAIL_CF_TEMP_SITE_TOKEN=
EMAIL_CF_TEMP_ADMIN_KEY=
# 按数组顺序轮询；空数组 + AUTO_DOMAIN=1 表示服务端自动选择
EMAIL_CF_TEMP_DOMAINS_JSON=[]
EMAIL_CF_TEMP_AUTO_DOMAIN=1
EMAIL_CF_TEMP_RANDOM_SUBDOMAIN=0
EMAIL_CF_TEMP_CONCURRENCY=10

# ---------- 旧版本兼容变量（新页面保存时自动双写） ----------
WORKER_DOMAIN=
FREEMAIL_TOKEN=
FREEMAIL_ADMIN_KEY=
FREEMAIL_DOMAIN=auto
FREEMAIL_RANDOM_SUBDOMAIN=0
FREEMAIL_API_STYLE=auto
EMAIL_TYPE=freemail
OUTLOOK_ACCOUNTS=
OUTLOOK_ALIAS_LIMIT=5

# Turnstile
# 不填 YESCAPTCHA_KEY 则使用本地 Solver
YESCAPTCHA_KEY=
SOLVER_URL=http://127.0.0.1:5072
SOLVER_BROWSER=camoufox
# 建议 4~8，与注册并发匹配
SOLVER_THREADS=4
# 单个 Solver 浏览器处理指定数量后轮换，防止长批次内存膨胀
SOLVER_BROWSER_MAX_USES=100
# 注册批次结束后空闲多少秒自动停止本地 Solver；0 表示不自动停止
SOLVER_IDLE_SHUTDOWN_SECONDS=60
SOLVER_HOST=127.0.0.1
SOLVER_PORT=5072
SOLVER_DEBUG=0
# 大体积 FO/RCH 诊断抓包默认关闭；仅排障时临时开启
SOLVER_CAPTURE_DUMPS=0
SOLVER_CAPTURE_MAX_GROUPS=20
SOLVER_CAPTURE_MAX_MB=50
# turnstile_solver.log / standalone_live.log：每份上限与总文件数（含当前）
LOG_MAX_MB=10
LOG_ROTATE_FILE_COUNT=3

# SSO 后后台换 token / NSFW 等线程
ENRICH_WORKERS=12
# Risk / OAuth / BFS 通过后，首次异步对话检测的延迟（秒）；范围 0~3600
GROK_ACCOUNT_CHECK_DELAY_SECONDS=60

# Web 控制台
UI_HOST=127.0.0.1
UI_PORT=3333
# BFS 运维 API 强制使用；请换成至少 32 字节随机值
MONITOR_TOKEN=replace-with-a-long-random-token

# ---------- sub2api（HTTP 导入）----------
# 兼容旧版本：首次打开 /import-services 时会迁移到独立导入配置。
# Docker 中访问宿主机服务请改用 host.docker.internal，不要使用 127.0.0.1。
# 如果 sub2api 已有 HTTPS 反代，优先填写该反代根地址，例如 https://sub.example.com。
# 根地址，不要末尾 /
SUB2API_URL=http://127.0.0.1:9898
# 只填分组名称；ID 可留空，程序按名称自动解析并回写
SUB2API_GROK_GROUP_NAME=grok
SUB2API_GROK_GROUP_ID=
# 旧版兼容地址；保持与 SUB2API_URL 相同。管理员账号仅保存在真实 .env。
UPSTREAM_URL=http://127.0.0.1:9898
UPSTREAM_ADMIN_EMAIL=admin@example.com
UPSTREAM_ADMIN_PASSWORD=your-admin-password
