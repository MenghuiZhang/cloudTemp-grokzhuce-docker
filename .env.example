# freemail / cloudflare_temp_email
# WORKER_DOMAIN 不要带 https://
WORKER_DOMAIN=your-worker.workers.dev
# cloudflare_temp_email 填站点密码；旧 freemail 填 JWT
FREEMAIL_TOKEN=your-password-or-jwt
# cloudflare_temp_email 的 ADMIN_PASSWORDS 之一；填写后走 /admin/new_address
# 如果与站点密码相同，可填 ${FREEMAIL_TOKEN}
FREEMAIL_ADMIN_KEY=
# 邮箱后缀：auto=服务端默认；或具体域名（控制台可自动拉取）
FREEMAIL_DOMAIN=auto
# 1=创建时向 cloudflare_temp_email 传 enableRandomSubdomain=true
# 需将 FREEMAIL_DOMAIN 设为 Worker 的 RANDOM_SUBDOMAIN_DOMAINS 基础域名
FREEMAIL_RANDOM_SUBDOMAIN=0
# auto | cf_temp | freemail
FREEMAIL_API_STYLE=auto

# Outlook/Hotmail 加号地址支持（例如 name+随机标签@outlook.com）
# EMAIL_TYPE = freemail | outlook-hotmail
EMAIL_TYPE=freemail

# 当 EMAIL_TYPE=outlook-hotmail 时生效
# 每行一个账号，支持：
# email:应用密码
# email----应用密码----refresh_token----client_id（优先 OAuth2）
OUTLOOK_ACCOUNTS=
# 每个主账号在一次运行中可分配的加号地址上限（默认 5）
OUTLOOK_ALIAS_LIMIT=5

# Turnstile
# 不填 YESCAPTCHA_KEY 则使用本地 Solver
YESCAPTCHA_KEY=
SOLVER_URL=http://127.0.0.1:5072
SOLVER_BROWSER=camoufox
# 建议 4~8，与注册并发匹配
SOLVER_THREADS=4
SOLVER_HOST=127.0.0.1
SOLVER_PORT=5072
SOLVER_DEBUG=0

# SSO 后后台换 token / NSFW 等线程
ENRICH_WORKERS=12

# Web 控制台
UI_HOST=127.0.0.1
UI_PORT=3333

# 注册代理（空=直连）
# 格式: host:port | http://host:port | user:pass@host:port | host:port:user:pass
GROK_PROXY=

# ---------- sub2api（HTTP 导入）----------
# 根地址，不要末尾 /
SUB2API_URL=http://127.0.0.1:9898
# 只填分组名称；ID 可留空，程序按名称自动解析并回写
SUB2API_GROK_GROUP_NAME=grok
SUB2API_GROK_GROUP_ID=
# 管理员账号（仅本地 .env）
UPSTREAM_URL=http://127.0.0.1:9898
UPSTREAM_ADMIN_EMAIL=admin@example.com
UPSTREAM_ADMIN_PASSWORD=your-admin-password
